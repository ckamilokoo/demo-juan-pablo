# Agente de voz (OpenAI). Copia este archivo a .env y completa la key.
OPENAI_API_KEY=sk-...

# Opcionales
# Modelo del analista LangGraph (texto)
OPENAI_MODEL=gpt-4.1-mini
# Modelo de voz en tiempo real
OPENAI_REALTIME_MODEL=gpt-realtime
# Voz: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_VOICE=marin

# Correo del agente (Gmail SMTP con contraseña de aplicación, igual que Backend-GM).
# Pega aquí los valores; nunca los subas al repositorio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Opcionales
# SMTP_FROM=
# SMTP_FROM_NOMBRE=Atlas · Planta Demo

# Agenda de contactos que el agente reconoce por nombre (JSON en una línea)
CONTACTOS_CORREO={"mantenimiento":"mantenimiento@ejemplo.cl","jefe de turno":"turno@ejemplo.cl"}
